# =====================================================================
# Issue Whisperer — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# =====================================================================

# ── LLM Provider ─────────────────────────────────────────────────────
# Options: ollama (default, free), openrouter, openai_compatible
LLM_PROVIDER=ollama

# Model name
# Ollama example:     gemma3:4b
# OpenRouter example: google/gemma-3-4b-it:free
LLM_MODEL=gemma3:4b

# Base URL for the LLM provider
# Ollama default:  http://localhost:11434
# OpenRouter:      https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434

# API key — leave blank for Ollama (not required)
# Required for OpenRouter or other paid providers
LLM_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────
# Device for local embedding model: cuda (NVIDIA GPU) or cpu
EMBEDDING_DEVICE=cuda

# ── GitHub ────────────────────────────────────────────────────────────
# Optional: GitHub Personal Access Token (read-only scope: public_repo)
# Without a token: 60 requests/hr  |  With token: 5000 requests/hr
GITHUB_TOKEN=

# ── Application ───────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
